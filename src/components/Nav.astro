---
import site from '../data/site';
import { getDict, type Lang } from '../i18n/ui';
import { asset } from '../utils/paths';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
const otherLang: Lang = lang === 'es' ? 'en' : 'es';
const homeHref = lang === 'es' ? asset('/') : asset('/en/');
---

<header class="site-nav">
  <div class="container inner">
    <a class="brand" href={homeHref}>{site.handle}</a>
    <nav aria-label={t['nav.label']}>
      <a href="#about">{t['nav.about']}</a>
      <a href="#projects">{t['nav.projects']}</a>
      <a href="#skills">{t['nav.skills']}</a>
      <a href="#contact">{t['nav.contact']}</a>
    </nav>
    <a class="lang" data-lang-switch href={lang === 'es' ? asset('/en/') : asset('/')} title={otherLang === 'es' ? 'Español' : 'English'}>
      {otherLang.toUpperCase()}
    </a>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 64px;
    padding-block: 0.5rem;
  }

  .brand {
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }

  nav {
    display: flex;
    gap: 1.7rem;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--muted);
  }

  nav a {
    transition: color 0.15s ease;
  }

  nav a:hover {
    color: var(--ink);
  }

  .lang {
    flex-shrink: 0;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.38rem 0.72rem;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .lang:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  @media (max-width: 720px) {
    .inner {
      justify-content: center;
      row-gap: 0.4rem;
    }

    .brand {
      position: absolute;
      left: 1.25rem;
    }

    .lang {
      position: absolute;
      right: 1.25rem;
    }
  }
</style>

<script>
  const sw = document.querySelector<HTMLAnchorElement>('[data-lang-switch]');
  if (sw && location.hash) {
    sw.href += location.hash;
  }
</script>

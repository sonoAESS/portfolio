---
import site from '../data/site';
import { getDict, type Lang } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
const year = new Date().getFullYear();

const socials = [
  { icon: 'github', href: site.socials.github, label: 'GitHub' },
  { icon: 'linkedin', href: site.socials.linkedin, label: 'LinkedIn' },
  { icon: 'badge', href: site.socials.orcid, label: `ORCID ${site.orcidId}` },
] as const;
---

<footer class="site-footer">
  <div class="container inner">
    <p class="copy">© {year} {site.name}. {t['footer.rights']}</p>
    <ul class="socials">
      {
        socials.map((social) => (
          <li>
            <a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={social.label} title={social.label}>
              <Icon name={social.icon} size={18} />
            </a>
          </li>
        ))
      }
    </ul>
    <p class="made">{t['footer.madeWith']} · {site.handle}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    flex-wrap: wrap;
    padding-block: 2rem;
    font-size: 0.88rem;
    color: var(--muted);
  }

  .socials {
    list-style: none;
    padding: 0;
    display: flex;
    gap: 0.6rem;
  }

  .socials a {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--line);
    color: var(--muted);
    background: var(--surface);
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      transform 0.15s ease;
  }

  .socials a:hover {
    color: #fff;
    background: var(--ink);
    border-color: var(--ink);
    transform: translateY(-2px);
  }

  @media (max-width: 720px) {
    .inner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
